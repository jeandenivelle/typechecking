

// True if Nary term arN contains sel

bool contains( sel : selector sel, arN : Form / ( .sel == ?and | .sel == ?or )
   for size_t i = 0; i != arN. size; ++ i :
      if( arN. sub(i). sel == sel )
         return true; 
   return false;

bool equal( const mathexpr& expr, const rational& rat )
   return expr. sel == ?rat && expr. val == rat; 


// Push_back all of from into to:

void push_back( from : Form / ( .sel == ?and | .sel == ?or ) ,
                to : form / ( .sel == ?and | .sel == ?or ) 
   for size_t i = 0; i != from. size; ++ i 
      to. push_back( from. sub(i) )


namespace efficient
{

   struct simplifier
      nruses : u64 

   __init__( ) 
         : nruses(0)
      { }

   mathexpr operator( ) ( simp: simplifier, expr : mathexpr )
      if( expr. sel == ?add )

            bool contains0 = false;
            for( size_t i = 0; i != expr. size; ++ i )
            {
               if( equal( expr. sub(i), rational(0)) )
                  contains0 = true;
            }

            if( contains0 )
            {
               auto res = mathexpr_add( {} );
               for( size_t i = 0; i != expr. size; ++ i )
               {
                  if( !equal( expr. sub(i), rational(0)) ) 
                     res. view_arithN( ). push_back( expr. sub(i));
               }
               ++ nruses; 
               return res;
            }
         }

         if( expr. sel == sel_mul )
         {  
            bool contains0 = false;
            bool contains1 = false;
            for( size_t i = 0; i != expr. size; ++ i )
            {
               if( equal( expr. sub(i), rational(1)))
                  contains1 = true;

               if( equal( expr. sub(i), rational(0)))
                  contains0 = true; 
            }

            if( contains0 )
            {
               ++ nruses;
               return mathexpr_rat(0);
            }

            if( contains1 )
            {
               auto res = mathexpr_mul( {} );  
               for( size_t i = 0; i != expr. size; ++ i )
               {
                  if( !equal( expr. sub(i), rational(1)))
                     res. view_arithN( ). push_back( expr. sub(i));
               }
               ++ nruses; 
               return res;
            }
         }
       
         if( expr. sel == sel_neg )
         {
            auto ar1 = expr. view_arith1( );
            if( ar1. sub( ). sel == sel_neg )
            {
               auto ar1a = ar1. sub( ). view_arith1( );
               return ar1a. sub( );
            }
         }
 
         return expr;
      }   

   };


   struct flattener
   {
      uint64_t nruses;

      flattener( ) 
         : nruses(0)
      { }
 
      mathexpr operator( ) ( mathexpr expr ) 
      {
         if( expr. sel == sel_add && expr. view_arithN( ). size == 0 )
         {
            ++ nruses; 
            return mathexpr_rat(0);
         }

         if( expr. sel == sel_mul && expr. view_arithN( ). size == 0 )
         {
            ++ nruses; 
            return mathexpr_rat(1);
         }

         if( expr. sel == sel_add || expr. sel == sel_mul )
         {
            if( expr. size == 1 )
               return expr. sub(0);   // Trivial case +(N) or *(N).

            if( contains( expr. sel, expr )) 
            {
               auto res = mathexpr( expr. sel, { } );
               for( size_t i = 0; i != expr. size; ++ i )
               {
                  if( expr. sub(i). sel == expr. sel )
                  {
                     push_back( expr. sub(i). view_arithN( ), 
                                res. view_arithN( ));
                  }
                  else
                     res. view_arithN( ). push_back( expr. sub(i)); 
               }
               ++ nruses; 
               return res; 
            }
         }
         return expr; 
      }

   };

}


mathexpr deriv( expr : mathexpr, var : std::string )
{
   switch expr. sel : 
   case ?rat:
      return mathexpr( ?rat, 0 ) 

   case ?var: 
      if( expr. name == var )
         return mathexpr( ?rat, 1 )
      else
         return mathexpr( ?rat, 0 )

   case sel_sub:
         return mathexpr( ?diff, deriv( ar2. sub1, var ),
                                 deriv( ar2. sub2, var ))
 
   case sel_add:
         auto res = mathexpr( ?add, { } )
         for size_t i = 0; i != expr. size; ++ i : 
            res. push_back( deriv( expr. sub(i), var ));

         return res;

   case sel_mul:
         auto sum = mathexpr( ?add, {} );

         for size_t i = 0; i != expr. size; ++ i : 
            auto prod = mathexpr( ?mul, {} ); 
            for size_t i1 = 0; i1 != expr. size; ++ i1
               if( i1 != i )
                  prod. push_back( expr. sub( i1 ));
               else
                  prod. push_back( deriv( expr. sub(i), var ));
           
            sum. push_back( prod ); 

         return sum;

   case sel_truediv:
         auto& sub1 = expr. sub1;
         auto& sub2 = expr. sub2;
         auto deriv1 = deriv( sub1, var );
         auto deriv2 = deriv( sub2, var );

         return mathexpr( ?truediv, 
            mathexpr( ?sub, 
               mathexpr( ?mul, { deriv1, sub2 } ),
               mathexpr( ?mul, { sub1, deriv2 } )),
            mathexpr( ?mul, { sub2, sub2 } ));

   case sel_pow:
      if( expr. sub1. sel == ?var && expr. sub2. sel == ?rat )
         if( expr. sub1. name( ) != var )
            return mathexpr( ?rat, 0 )

            const auto& exp = expr. sub2. val( );
            if( exp == 0 )
               return mathexpr( ?rat, 0 );
            return mathexpr( ?mul, { mathexpr( ?rat, exp ), 
                      mathexpr( ?pow, spec2, mathexpr( ?rat, exp - 1 )) } );

   case sel_sin:
      return mathexpr( ?mul, { 
         cos( ?cos, expr. sub ), deriv( expr. sub, var ) } );

   case sel_cos:
      return mathexpr( ?mul, { 
         mathexpr( ?neg, 
            mathexpr( ?sin, expr. sub )),
                   deriv( expr. sub, var ) } );
   }

   std::cout << expr. sel << "\n";
   throw std::logic_error( "deriv: unhandled case" );   
}


int main( int argc, char *argv[] )
{
   bigint num = 10;
   bigint denom = 21;

   auto expr = mathexpr_mul( 
               { mathexpr_sin( mathexpr_var( "xx" )), 
                 mathexpr_cos( mathexpr_var( "xx" )), 
                 mathexpr_pow( mathexpr_var( "xx" ), mathexpr_rat(2)) } );

   expr = deriv( expr, "xx" );
   std::cout << "derivative: " << expr << "\n\n";

   {
      efficient::simplifier simpl;
      expr = normalize( simpl, std::move( expr ) );
      std::cout << "after simplification: " << expr << "\n";
   }
 
   return 0;

   expr = mathexpr( sel_truediv, 
             mathexpr_sin( mathexpr_var( "x" )),
             mathexpr_cos( mathexpr_var( "x" )) );


   auto x = mathexpr_var( "x" ); 
   auto e = mathexpr_add( 
      { mathexpr_sin( mathexpr_neg( mathexpr_neg( x ))),
        mathexpr_cos( mathexpr_neg( mathexpr_neg( x ))) } );
   std::cout << e << "\n";
   efficient::simplifier simpl;
   e = outermost( simpl, std::move(e) );
   std::cout << "after simplification: " << e << "\n";

   efficient::concat< efficient::flattener, efficient::simplifier > red;


   return 0; 
}

