   tree.cpp

  
%preproc $(Treegen)/treegen regexp/treedefs.rec
%dir Source/regexp
%in 
   treedefs.rec
%out
   selector.h
   selector.cpp
   expr.h
   expr.cpp

%preproc $(Treegen)/treegen intermediate/treedefs.rec
%dir Source/intermediate
%in 
   treedefs.rec
%out
   selector.h
   selector.cpp
   flatterm.h
   flatterm.cpp
   statement.h
   statement.cpp


