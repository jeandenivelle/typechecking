
%comment TYPECHECKING

%rootdirs 
   Source = .
   Lexing = /home/nivelle/programs
   Tvm = /home/nivelle/programs
   Maph = /home/nivelle/programs/maphoon
   Treegen = /home/nivelle/programs/treegen2023
   Util = /home/nivelle/programs

%dir Source
%exec types

%sources
   types.cpp
   identifier.cpp
   fieldmap.cpp
   tests.cpp

%dir Source/data
%sources
   tree.cpp
   selector.cpp
   printing.cpp
   examples.cpp

%dir Source/regexp
%sources
   selector.cpp
   expr.cpp
   defmap.cpp
   printing.cpp

%dir Source/atm
%sources

%dir Source/intermediate
%sources
   statement.cpp
   flatterm.cpp

%dir Util
%sources
   util/bigint.cpp

%options 
   Wall
   Wno-switch
   Wno-invalid-offsetof
   Wno-unused-function
   pedantic-errors
   std=c++23

%includedirs
   Lexing
   Util
   Tvm
   Source   

