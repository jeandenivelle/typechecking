
%dir data

%namespace data
   // Namespace in which the resulting types will be put.

%define tree ( dat_unit )

%option never   { dat_never }    => n : never
%option unit    { dat_unit }     => 
%option bool    { dat_bool }     => b : bool
%option char    { dat_char }     => c : char
%option usel    { dat_sel }     => s : usel
%option u64     { dat_u64 }      => u : uint64_t
%option integer { dat_integer }  => i : bigint 
%option double  { dat_double }   => d : double 

%option tuple { dat_tuple } => [ val : tree ]
   // We are agnostic about the question whether
   // the tuple is stored in place, or below a pointer.

%option array { dat_array } => [ val : tree ] 
   // Always under a pointer. 

%h_incl {
   #include <initializer_list>
   #include <concepts>

   #include "tvm/includes.h"
   #include "tvm/unit.h" 
   #include "never.h"
   #include "usel.h"
   #include "util/print.h"
   #include "util/bigint.h"
}


%h_methods {
   void print( std::ostream& ) const;
} 



