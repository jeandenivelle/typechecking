
// The result of a conversion. 
// Written by Hans de Nivelle (Nov) 2026.

%dir atm

%namespace atm

%define convresult     ( atm_unknown )
   // Not used, but TreeGen needs an option without fields.

%option unknown        { atm_unknown } => // Used as default.
%option single         { atm_single } => # q : state
%option tuple          { atm_tuple } =>  # q : state, sz : size_t 
                          // sz is at least, not exact.
%option set            { atm_set } => bld : builder 
%option error          { atm_error } => cause : std::string

%h_incl {
	#include "builder.h"
	#include "util/print.h"
	#include "tvm/includes.h"
}

%h_methods {
      void print( std::ostream& ) const;
}


%cpp_back
{
   void atm::convresult::print( std::ostream& out ) const 
   {
      switch( sel( ))
      {
      case atm_unknown:
         out << "unknown";
         return;

      case atm_single:
         out << "single( " << view_single( ). q( ) << " )";
         return;

      case atm_tuple:
         {
            auto tup = view_tuple( ); 
            out << "tuple( " << tup. q( ) << ", #" << tup. sz( ) << " )";
            return;
         }
      
      case atm_set:
         {
            auto set = view_set( );
            out << "set( " << set. bld( ). nrstates << " )";
            return;
         }

      case atm_error:
         {
            out << "error( " << view_error( ). cause( ) << " )";
            return;
         }
      }
      std::cout << "convresult::print:   " << sel( ) << "\n";
      throw std::logic_error( "not implemented" );
   }

}


