
// Definition of regexp on data trees. Hans de Nivelle July (Oct) 2026.

%dir regexp

%namespace regexp

%define expr ( type_never )

%option type_never   { type_never } => 
%option type_unit    { type_unit } => 
%option filter_bool    { flt_bool } => 
            func : stepfunc< bool, bool > 
%option filter_char    { flt_char } => 
            func : stepfunc< char, bool > 
%option filter_sel     { flt_sel } => 
            func : finfunc< usel, bool, usel::hash, usel::equal_to > 
%option filter_u64     { flt_u64 } =>
            func : stepfunc< uint64_t, bool >
%option filter_integer { flt_integer } =>
            func : stepfunc< bigint, bool > 
%option type_double  { type_double } => 

%option reference      { ref_ident } => # ident : identifier
   // A reference to a defined identifier.

%option tuple          { tup_constr } => [ sub : expr ]
%option fill           { tup_fill } => prefix : expr, [ filler : expr ] 
   // Fill the rest with ( filler1 | ... | fillern )^{*}. 

%option disjunction    { log_or } => [ sub : expr ]

// Multiset operations:

%option word           { set_word } => [ smp : expr ]
%option multiply       { set_linear, set_circular } => 
                          set : expr, factor : size_t, [ disj : expr ]
      
%h_incl {
	#include "identifier.h"
        #include "finfunc.h"
        #include "stepfunc.h"
	#include "util/print.h"
	#include "tvm/includes.h"
	#include "usel.h"
        #include "util/bigint.h"
}

%h_methods {
	void print( std::ostream& ) const;
}

%h_after
{
   inline expr any_bool( )
      { return expr( flt_bool, stepfunc< bool, bool > ( true )); } 
   inline expr any_char( )
      { return expr( flt_char, stepfunc< char, bool > ( true )); }
   inline expr any_selector( )
      { return expr( flt_sel, 
            finfunc< usel, bool, usel::hash, usel::equal_to > ( true )); }
   inline expr any_u64( )  
      { return expr( flt_u64, stepfunc< uint64_t, bool > ( true )); }
   inline expr any_integer( )
      { return expr( flt_integer, stepfunc< bigint, bool > ( true )); }


   expr chars( const std::vector< std::pair< char, bool >> & steps );

   expr selectors( const std::vector< usel > & sels );

   expr u64s( const std::vector< std::pair< uint64_t, bool >> & steps );

   expr tuple( const std::vector< expr > & single );

   expr forall( const std::vector< expr > & disj ); 
}

%cpp_back
{
   regexp::expr regexp::selectors( const std::vector< usel > & sels )
   {
      auto f = finfunc< usel, bool, usel::hash, usel::equal_to > ( false );
      for( auto s : sels )
         f. assign( s, true );       
      return expr( flt_sel, std::move(f));
   }

   regexp::expr 
   regexp::u64s( const std::vector< std::pair< uint64_t, bool >> & steps )
   {
      auto func = stepfunc< uint64_t, bool > ( false );
      for( auto s : steps )
         func. append( s.first, s.second );
      return expr( flt_u64, std::move( func ));
   }
   
   regexp::expr regexp::tuple( const std::vector< expr > & single )
   {
      return expr( tup_constr, single. begin( ), single. end( ));
   }

   regexp::expr regexp::forall( const std::vector< expr > & disj )
   {
      return expr( set_circular, expr( set_word, { } ), (uint64_t) 0, 
                                 disj. begin( ), disj. end( ));
   }
}


// Automata need types, because an automaton for
// set has an entry and an exit point, while an automaton
// for a single value, has only an exit point.
//
// The type checking algorithm uses a fixed point 
// construction, due to the fact that 
// definitions of regular expressions.
// 
// Because of that, we added lattice types 
//    unknown (bottom) and error (top). 


