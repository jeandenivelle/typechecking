
%dir regexp

%namespace regexp

%define expr ( type_never )

%option type_never     { type_never } => 
%option type_unit      { type_unit } => 
%option type_bool      { type_bool } => 
%option type_char      { type_char } => 
%option type_sel       { type_sel } => 
%option type_u64       { type_u64  } => 
%option type_integer   { type_integer } => 
%option type_double    { type_double } => 
%option type_iter      { type_iter } =>

%option filter_bool    { flt_bool } => # b : bool  
%option filter_sel     { flt_sel } => 
               fin : finfunc< usel, bool, usel::hash, usel::equal_to > 
%option filter_char    { flt_char } => 
               part : partition< char, bool > 

%option ident          { ident } => # ident : identifier

%option tuple          { tuple } => [ sub : expr ]
%option concat         { concat } => first : expr, second : expr 

%option logical        { set_intersect, set_union } => [ sub : expr ]

%option simple    { emptyset, nonemptyset } => 
%option quant     { log_exists, log_forall } => sub : expr

%h_incl {
	#include "identifier.h"
        #include "finfunc.h"
        #include "partition.h"
	#include "util/print.h"
	#include "tvm/includes.h"
	#include "usel.h"
}

%h_methods {
	void print( std::ostream& ) const;
}

%h_after
{
   expr selectors( const std::vector< usel > & sels );
}

%cpp_back
{
   regexp::expr regexp::selectors( const std::vector< usel > & sels )
   {
      auto f = finfunc< usel, bool, usel::hash, usel::equal_to > ( false );
      for( auto& s : sels )
         f. assign( s, true );       
      return expr( flt_sel, std::move(f));
   }

}


