
// Definition of regexp on data trees. Hans de Nivelle July (Oct) 2026.

%dir regexp

%namespace regexp

%define expr ( type_never )

%option type_never     { type_never } => 
%option type_unit      { type_unit } => 
%option type_bool      { type_bool } => 
%option type_char      { type_char } => 
%option type_sel       { type_sel } => 
%option type_u64       { type_u64  } => 
%option type_integer   { type_integer } => 
%option type_double    { type_double } => 
%option type_iter      { type_iter } =>

%option filter_bool    { flt_bool } => b : bool
%option filter_char    { flt_char } => 
           part : stepfunc< char, bool > 
%option filter_sel     { flt_sel } => 
           fin : finfunc< usel, bool, usel::hash, usel::equal_to > 
%option filter_u64     { flt_u64 } =>
           part : stepfunc< size_t, bool >
%option filter_integer { flt_integer } =>
           part : stepfunc< bigint, bool > 

%option reference      { ref_ident } => # ident : identifier
   // A reference to a defined identifier.

%option tuple          { tup_constr } => [ sub : expr ]
   // Earlier versions had a tuple concatenation operator,
   // but this operator is useless.

%option append         { tup_append } => tup : expr, [ sub : expr ] 

%option logical        { log_and, log_or } => [ sub : expr ]
   // everything = log_and( ), and nothing = log_or( ).

// (Multiset) operations are a bit confusing because we 
// are constructing set of sets. If you call an operator for example
// 'union' there is confusion on which level the union takes place.
// In the case below, it is on the lower level.

%option word           { set_word } => [ sym : expr ]
%option dimension      { set_linear, set_circular } => 
                          set : expr, nr : size_t, [ sym : expr ]
      
%h_incl {
	#include "identifier.h"
        #include "finfunc.h"
        #include "stepfunc.h"
	#include "util/print.h"
	#include "tvm/includes.h"
	#include "usel.h"
        #include "util/bigint.h"
}

%h_methods {
	void print( std::ostream& ) const;
}

%h_after
{
   expr selectors( const std::vector< usel > & sels );
   expr tuple( const std::vector< expr > & sym );
   expr forall( const std::vector< expr > & sym ); 
}

%cpp_back
{
   regexp::expr regexp::selectors( const std::vector< usel > & sels )
   {
      auto f = finfunc< usel, bool, usel::hash, usel::equal_to > ( false );
      for( auto& s : sels )
         f. assign( s, true );       
      return expr( flt_sel, std::move(f));
   }

   regexp::expr regexp::tuple( const std::vector< expr > & sym )
   {
      return expr( tup_constr, sym. begin( ), sym. end( ));
   }

   regexp::expr regexp::forall( const std::vector< expr > & sym )
   {
      return expr( set_linear, expr( set_word, { } ), (size_t) 0, 
                   sym. begin( ), sym. end( ));
   }
}


// Automata need types, because an automaton for
// set has an entry and an exit point, while an automaton
// for a single value, has only an exit point.
//
// The type checking algorithm uses a fixed point 
// construction, due to the fact that 
// definitions of regular expressions.
// 
// Because of that, we added lattice types 
//    unknown (bottom) and error (top). 


%define exprtype ( exprtype_unknown )

%option value      { exprtype_single, exprtype_set, exprtype_tuple } =>
   // 'set' = multiset. 

%option lattice     { exprtype_unknown, exprtype_error } =>
   // Unknown is the bottom of the lattice, and error
   // is the top of the lattice. 

%h_incl
{
   #include "tvm/includes.h"
   #include "util/print.h"
}

%h_methods 
{
   void print( std::ostream& ) const;
   bool isbelow( selector s ) const
      { return sel( ) == exprtype_unknown || sel( ) == s; }

}

%h_after
{
   inline bool operator == ( exprtype tp1, exprtype tp2 )
      { return tp1. sel( ) == tp2. sel( ); }

}

