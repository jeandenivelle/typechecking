
// Definition of regexp on data trees. Hans de Nivelle July (Oct) 2026.

%dir regexp

%namespace regexp

%define expr ( type_never )

%option type_never     { type_never } => 
%option type_unit      { type_unit } => 
%option type_bool      { type_bool } => 
%option type_char      { type_char } => 
%option type_sel       { type_sel } => 
%option type_u64       { type_u64  } => 
%option type_integer   { type_integer } => 
%option type_double    { type_double } => 
%option type_iter      { type_iter } =>

%option filter_bool    { flt_bool } => b : bool
%option filter_char    { flt_char } => 
               part : partition< char, bool > 
%option filter_sel     { flt_sel } => 
               fin : finfunc< usel, bool, usel::hash, usel::equal_to > 
%option filter_u64     { flt_u64 } =>
               part : partition< size_t, bool >
%option filter_integer { flt_integer } =>
               part : partition< bigint, bool > 

%option ident          { def_ident } => # ident : identifier
   // We are referring to a defined identifier.

%option tuple          { tup_constr, tup_concat } => [ sub : expr ]

%option logical        { log_and, log_or } => [ sub : expr ]
   // everything = log_and( ), and nothing = log_or( ).

// (Multiset) operations are a bit confusing because we 
// are constructing set of sets. If you call an operator for example
// 'union' there is confusion on which level the union takes place.
// In the case below, it is on the lower level.

%option set_unary      { set_single, set_repeat } => sub : expr
%option set_union      { set_union } => [ sub : expr ] 

%h_incl {
	#include "identifier.h"
        #include "finfunc.h"
        #include "partition.h"
	#include "util/print.h"
	#include "tvm/includes.h"
	#include "usel.h"
        #include "util/bigint.h"
}

%h_methods {
	void print( std::ostream& ) const;
}

%h_after
{
   expr selectors( const std::vector< usel > & sels );
   expr tuple( const std::vector< expr > & e );
}

%cpp_back
{
   regexp::expr regexp::selectors( const std::vector< usel > & sels )
   {
      auto f = finfunc< usel, bool, usel::hash, usel::equal_to > ( false );
      for( auto& s : sels )
         f. assign( s, true );       
      return expr( flt_sel, std::move(f));
   }

   regexp::expr regexp::tuple( const std::vector< expr > & e )
   {
      return expr( tup_constr, e. begin( ), e. end( ));
   }

}


%define exprtype ( exprtype_onevalue )

%option onevalue    { exprtype_onevalue } =>
%option tuple       { exprtype_tuple } =>  arity : size_t 
%option array       { exprtype_array } =>

%h_incl
{
   #include "tvm/includes.h"
   #include "util/print.h"
}

%h_methods 
{
   void print( std::ostream& ) const;
}


